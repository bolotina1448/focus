.field private static final FORMAT_HINT:Ljava/lang/String; = "\u0420\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043e \u043a\u0430\u043a \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043d\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0441 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u043c \u0432\u0438\u0434\u0430 \u00ab10\u0418, \u043f\u043e\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u0438\u043a\u00bb \u0438 \u043a\u043e\u043b\u043e\u043d\u043a\u0430\u043c\u0438 \u00ab\u0443\u0440\u043e\u043a\u00bb, \u00ab\u0432\u0440\u0435\u043c\u044f\u00bb, \u00ab\u043f\u0440\u0435\u0434\u043c\u0435\u0442\u00bb, \u00ab\u043a\u0430\u0431\u0438\u043d\u0435\u0442\u00bb, \u00ab\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u00bb. \u041d\u0443\u043c\u0435\u0440\u0430\u0446\u0438\u044f \u0443\u0440\u043e\u043a\u043e\u0432 \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c\u0441\u044f \u0441 0 \u2014 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0439 \u043d\u043e\u043c\u0435\u0440\u0430 \u043a\u0430\u043a \u043d\u0430 \u0444\u043e\u0442\u043e. \u041a\u043e\u043b\u043e\u043d\u043a\u0443 \u00ab\u0443\u0447\u0438\u0442\u0435\u043b\u044c\u00bb \u043d\u0435 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0439. \u0421\u0442\u0440\u043e\u043a\u0438 \u0431\u0435\u0437 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438. \u0412 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u0435 \u0431\u044b\u0432\u0430\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u0443\u043f\u043f: \u00ab\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 [10\u041c1] / \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a [10\u041c2] / \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 [10\u041c3]\u00bb, \u0430 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u044b \u0432 \u0442\u043e\u0439 \u0436\u0435 \u0441\u0442\u0440\u043e\u043a\u0435 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u044b \u0447\u0435\u0440\u0435\u0437 \u00ab/\u00bb \u0432 \u0442\u043e\u043c \u0436\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435: \u00ab300\u0440 / 202 / 501\u00bb. \u0422\u043e\u0433\u0434\u0430 \u0432\u0435\u0440\u043d\u0438 \u0442\u0430\u043a\u043e\u0439 \u0443\u0440\u043e\u043a \u043a\u0430\u043a \u0441\u043f\u0438\u0441\u043e\u043a \"variants\": [{\"subject\": \"\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430\", \"group\": \"10\u041c1\", \"room\": \"300\u0440\"}, {\"subject\": \"\u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u044f\u0437\u044b\u043a\", \"group\": \"10\u041c2\", \"room\": \"202\"}, \u2026] \u2014 \u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0443 \u043d\u0430 \u043a\u0430\u0436\u0434\u0443\u044e \u0447\u0430\u0441\u0442\u044c, \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u044b \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0443. \u0415\u0441\u043b\u0438 \u0443 \u043e\u0434\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u0440\u0443\u043f\u043f \u0447\u0435\u0440\u0435\u0437 \u00ab/\u00bb \u0432 \u0441\u043a\u043e\u0431\u043a\u0430\u0445 (\u00ab\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u043a\u0430 [10\u04181/10\u04182]\u00bb), \u0430 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u043e\u0432 \u0442\u043e\u0436\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e (\u00ab406 / 400\u0440\u00bb), \u0440\u0430\u0437\u0434\u0435\u043b\u0438 \u043d\u0430 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u043f\u043e \u0433\u0440\u0443\u043f\u043f\u0430\u043c \u0432 \u0442\u043e\u043c \u0436\u0435 \u043f\u043e\u0440\u044f\u0434\u043a\u0435. \u0413\u0440\u0443\u043f\u043f\u044b \u043f\u0438\u0448\u0438 \u043a\u0430\u043a \u0432 \u0441\u043a\u043e\u0431\u043a\u0430\u0445, \u0431\u0435\u0437 \u0441\u043a\u043e\u0431\u043e\u043a (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u00ab10\u04181+\u0415\u041d\u00bb). \u0415\u0441\u043b\u0438 \u0443\u0440\u043e\u043a \u0434\u043b\u044f \u0432\u0441\u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 \u2014 \u0431\u0435\u0437 variants, \u043f\u0440\u043e\u0441\u0442\u043e subject \u0438 room."

